# EduSphere Private LAN Deployment - Secure Environment Template
# Do NOT commit the real .env.lan file to source control.
# Run: cp .env.lan.example .env.lan and fill in real values.

# ── JWT Secrets (Must be 64+ random characters) ──
JWT_SECRET=generate_your_secure_secret_here
JWT_REFRESH_SECRET=generate_your_secure_refresh_here

# ── MongoDB Secrets ──
MONGO_INITDB_ROOT_USERNAME=edusphere_admin
MONGO_INITDB_ROOT_PASSWORD=generate_mongo_admin_pass

# Service-specific MongoDB Users
MONGO_AUTH_PASS=generate_mongo_auth_pass
MONGO_USER_PASS=generate_mongo_user_pass
MONGO_COURSE_PASS=generate_mongo_course_pass
MONGO_NOTIF_PASS=generate_mongo_notif_pass
MONGO_ATTENDANCE_PASS=generate_mongo_attendance_pass
MONGO_LIBRARY_PASS=generate_mongo_library_pass
MONGO_CALENDAR_PASS=generate_mongo_calendar_pass
MONGO_TIMETABLE_PASS=generate_mongo_timetable_pass
MONGO_FINANCE_PASS=generate_mongo_finance_pass
MONGO_ASSIGNMENT_PASS=generate_mongo_assignment_pass
MONGO_ASSESSMENT_PASS=generate_mongo_assessment_pass
MONGO_CERTIFICATE_PASS=generate_mongo_certificate_pass
MONGO_PLACEMENT_PASS=generate_mongo_placement_pass
MONGO_DISCUSSION_PASS=generate_mongo_discussion_pass
MONGO_ANALYTICS_PASS=generate_mongo_analytics_pass
MONGO_ADMIN_PASS=generate_mongo_admin_svc_pass

# ── RabbitMQ Secrets ──
RABBITMQ_DEFAULT_USER=edu_broker
RABBITMQ_DEFAULT_PASS=generate_rabbitmq_pass

# ── Redis Secrets ──
REDIS_PASSWORD=generate_redis_pass

# ── Meilisearch Secrets ──
MEILI_MASTER_KEY=generate_meili_master_key

# ── MinIO Secrets ──
MINIO_ROOT_USER=edusphere_storage_admin
MINIO_ROOT_PASSWORD=generate_minio_pass

# ── Grafana Admin ──
GF_SECURITY_ADMIN_PASSWORD=generate_grafana_pass

# ── Gateway Settings ──
PUBLIC_LAN_IP=192.168.1.100
