# ============================================================
# EduSphere Enterprise — Environment Configuration
# Copy to .env in each service and fill real values
# ============================================================

# ── Database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/edusphere
MONGO_URI_AUTH=mongodb://localhost:27017/edusphere_auth
MONGO_URI_USERS=mongodb://localhost:27017/edusphere_users
MONGO_URI_COURSES=mongodb://localhost:27017/edusphere_courses
MONGO_URI_NOTIFICATIONS=mongodb://localhost:27017/edusphere_notifications
MONGO_URI_ASSESSMENTS=mongodb://localhost:27017/edusphere_assessments
MONGO_URI_ASSIGNMENTS=mongodb://localhost:27017/edusphere_assignments
MONGO_URI_CERTIFICATES=mongodb://localhost:27017/edusphere_certificates
MONGO_URI_ATTENDANCE=mongodb://localhost:27017/edusphere_attendance

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672

# ── Meilisearch ───────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=edusphere_super_secret_jwt_key_change_in_production_2026
JWT_REFRESH_SECRET=edusphere_refresh_secret_change_in_production_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Service Ports ──────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
COURSE_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
ASSESSMENT_SERVICE_PORT=3005
ASSIGNMENT_SERVICE_PORT=3006
CERTIFICATE_SERVICE_PORT=3007
ATTENDANCE_SERVICE_PORT=3008

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Base URL (for QR code links) ───────────────────────────────────────────
BASE_URL=http://localhost

# ── File Storage ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Email (Nodemailer) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@edusphere.edu

# ── MinIO (Production File Storage) ───────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edusphere-files

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
